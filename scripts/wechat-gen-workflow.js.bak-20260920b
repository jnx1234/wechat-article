// 微信公众号减脂文章自动化生成 — 工作流编排脚本 v5
// v3 改进: 闺蜜聊天风、零金句、普通大白话
// v4 改进: 只产出 1 篇文章
// v5 改进: 对齐「轻食小本」人设 —— 固定数字、引导块、清单5拍、配图位、结尾转化
//          固定文案块由代码拼接，不经过 agent，避免被润色改花

export const meta = {
  name: 'wechat-gen-workflow',
  description: '6步流水线生成减脂长文(1500-2500字)：爆款标题(20)→精选(1)→闺蜜风正文→人设→情绪→排版→去味',
  phases: [
    { title: '🎯 标题生成', detail: '基于减脂话题生成20个爆款标题（含反转型）' },
    { title: '⭐ 标题甄选', detail: '从20个标题中精选最佳1个' },
    { title: '📝 文章流水线', detail: '1篇文章，闺蜜聊天风，1500-2500字' },
  ],
};

// ============================================================
// ★ 固定文案块 —— 要改风格只改这一段
// 注意：config/persona.md 有一份镜像，改完记得同步
// ============================================================

const ACCOUNT = '轻食小本';
const AUTHOR = '小轻';

// 固定数字（每篇必带，全文一致，不许改）
// 与已发布文章（2026-08-19 那篇小程序文）对齐：138 → 106，瘦 32 斤
const START_WEIGHT = 138;
const NOW_WEIGHT = 106;
const LOST_WEIGHT = START_WEIGHT - NOW_WEIGHT; // 32
const WEIGHT_TAG = `（${START_WEIGHT}-${NOW_WEIGHT}已掉${LOST_WEIGHT}斤）`;

// 配图位占位符前缀，用户照描述自己找图
const IMG_SLOT = '【配图：';

// 配图位数量（改这一个数就行，prompt 里的要求从这里取）
const IMG_MIN = 10;
const IMG_MAX = 14;

// 小程序（${AUTHOR}自己做的记体重工具）
// 2026-09-20 起：不再用【小程序卡片：…】占位符，改成引导块里一句话带过，
// 发的时候由使用者在小程序链接那一行贴真实链接（文案写的是「点上面的链接」）
const PROMO_NAME = '轻食小本';

// 开头引导块（逐字照贴，只替换 [主题一句话]）
const OPENING_BLOCK = `哈喽姐妹们

我是${ACCOUNT}的${AUTHOR}呀

你们的减脂闺蜜

记体重这件事太麻烦了，${AUTHOR}干脆自己动手，做了个小程序，叫${PROMO_NAME}，专门记体重。点上面的链接就能直接用。

今天来给你们聊一下

[主题一句话]

快点赞收藏

姐妹搬起板凳

开始咯

♥ ♥ ♥`;

// 真心话小标题（固定，不许改写）
const SINCERE_HEADING = '最后给大家说点真心话';

// 免责声明（逐字固定）
const DISCLAIMER = '本文仅为个人饮食经验分享，不构成医疗建议。减重效果因人而异，如有健康问题请咨询专业医生或营养师。';

// 结尾转化块（逐字固定）
const CLOSING_BLOCK = `宝子们

今天就分享到这里咯

我们下期再聊更多

吃对不饿瘦的小思路呀

评论区留“好好吃饭”

一起打卡健康减脂 爱惜自己

咱们下期再见

爱你们哟~

❥  关注${AUTHOR} 带你吃瘦不饿瘦`;

// ============================================================
// 人设
// ============================================================
const PERSONA = `
## 账号人设
- 账号：${ACCOUNT}　作者：${AUTHOR}
- 定位：一个靠自己摸索瘦了 ${LOST_WEIGHT} 斤的普通女生，不是教练，不是专家，就是走过弯路的过来人
- **自称**：用第三人称自称"${AUTHOR}"，比如"${AUTHOR}当时真的是小瞧它了""${AUTHOR}现在想起来就想翻白眼"。不要通篇用"我"，名字和"我"混着来，平均每 1-2 段出现一次"${AUTHOR}"
- 读者称呼：正文里用"姐妹们"，结尾用"宝子们"
- 语言：像给闺蜜发微信语音，说最普通的大白话，不加任何修饰
- 语气词：自然地用"呀""哦""啦""嘛"
- 自嘲感：可以笑自己走过的弯路

### 写作铁律
1. **零金句**：不要任何"金句"，不要比喻（什么"代谢是柴火"之类全删），不要排比，不要华丽句子
2. **普通描述**：用最平常的话把事说清楚就行。参考："这个方法对我管用，希望对你们也管用"——这就是最好的表达
3. **像发语音**：读起来像你按住微信语音键说的话，不是写出来的文章
4. **个人经验**：用自己的亲身经历说话，不讲大道理
5. **短段落**：一段最多 3 句话，一句话一段也完全可以

### 正确 vs 错误示例
- ❌ 金句："主食是你代谢的柴火，把柴抽了，火就灭了"
- ✅ 普通："不吃主食吧，身体没劲，代谢还往下掉，真的不划算"
- ❌ 金句："你已经在变好的路上了，身体只是需要一点时间跟上你的决心"
- ✅ 普通："别急，慢慢来，身体适应新习惯是需要时间的，我也是这样过来的"

### 绝对禁止
- 禁止任何金句、名言式表达
- 禁止华丽比喻和修饰（"像海绵一样""像柴火一样"）
- 禁止空洞鼓励（"相信自己""你一定可以"）
- 禁止AI过渡词：首先/其次/最后/综上所述
- 禁止绝对化承诺：唯一/最快/必须/彻底/根治（合规风险，不许写）
`;

// ============================================================
// 正文规格
// ============================================================
const ARTICLE_SPEC = `
## 你负责的范围

⚠️ 你只写【成果播报】到【真心话】这一段。
开头的引导块、免责声明、结尾转化块由系统自动拼接，**你不要写**，写了会被覆盖。

## 文章结构（严格遵循）

1. **成果播报**：交代自己的情况。⚠️ 小程序在开头引导块里已经一句话讲过了，**这一段不要再提它的来龙去脉**——不写备忘录/本子/换过几个 App，不写它帮了什么忙，也不再写它的名字。只写三件事：
   - **体重数字**：现在 ${NOW_WEIGHT} 斤，以前 ${START_WEIGHT} 斤，整整掉了 ${LOST_WEIGHT} 斤，前前后后花了差不多一年。
   - **落点**：收在"因为看得见变化，${AUTHOR}才没在中途放弃"上。顺着"记体重"这个动作带一句就够，别展开成广告。
   - 最后接一组**否定式排比**，逐条堵掉读者的质疑：没饿晕、没跑断腿、没吃减肥药、没办健身卡、没抽脂，至少写 3 个"没"。
2. **共鸣痛点**：连问两三个问题，把读者的困境原样说出来，再归因到身体机制上，明确告诉她们"不是你没毅力"。
3. **机制解释**：给 1 个机制名词（皮质醇 / 升糖指数 / 食物热效应 / GI值 / 果糖 / 抗性淀粉 这类），用最普通的话讲明白，不要术语堆砌。
4. **主清单**：3-4 项，每项严格按下面的 5 拍写。
5. **附加小节**（可选，看选题决定）：小习惯 / 常见问题 / 原则总结，最多只加一个。
6. **真心话**：小标题那一行**只写** \`【固定小标题】\` 这七个字——系统会替换成固定文案，你自己写的会被覆盖。下面 2-3 段，真实、不煽情。

## 排版格式（硬性要求）

- **小标题一律用纯文本**，单独成行。不要用 # / ## / ### / ** 包裹——这是写给公众号的，粘过去这些符号会原样显示出来
- **不许把结构名写进正文**。「成果播报」「共鸣痛点」「机制解释」「主清单」「小习惯」这些只是上面给你看的位置说明，是内部黑话，读者看不懂。要分段就自己写一句读者看得懂的话当小标题（比如「先交代一下${AUTHOR}自己的情况」「姐妹们是不是也有这种感觉」「接下来这几样，都是秋天里最冤的」「姐妹们问得最多的两个问题」），或者干脆不写小标题，让正文自己接下去
- **全文任何位置都不许出现 \`**\` 加粗符号**，正文也不例外。公众号后台是纯文本粘贴，\`**${NOW_WEIGHT} 斤**\` 粘过去会原样显示成两个星号。要强调就把话说重一点，别用符号
- 配图占位符单独成行，前后各空 1 行

## 清单每一项的 5 拍结构（一项都不能少）

① **小标题**：食物名或行为名（如「黑巧克力」「冬枣」「白粥加咸菜」）
② **副标题**：一句吐槽，8-15 字（如「小小一颗，热量高得离谱」）
③ **踩坑故事**：${AUTHOR}以前是怎么吃的、当时多离谱，带自嘲
④ **原理一句**：为什么这样不行，大白话，最多两句
⑤ **替代方案**："那我现在是怎么吃的呢？" → 给出具体替代品 + 大概的量 + 什么时候吃

⚠️ 第 ⑤ 拍必须写。只讲"要少吃"却不给替代品，这一项就是废的。

## 反转钩子（可选能力，不是每篇都用）

当选题本身带认知反差时（比如"大家以为是增肥的东西，其实是减脂利器"），用这个结构：
- 先立起读者的错误认知："姐妹们肯定觉得 XX 减肥不能碰吧？"
- 再推翻它，给出真实情况
- 通常挑 3 种"被冤枉的食物"，逐个平反

判断标准：选题本身有反差才用。纯清单型、纯原则型的选题别硬套。

## 配图位（必须加）

在正文里插入配图占位符，格式：**${IMG_SLOT}画面描述】**

- 每个清单项的小标题后面放 1 个
- 每个大段落（成果播报 / 痛点 / 机制 / 清单 / 小习惯 / 真心话）开头放 1 个
- **两个配图位之间必须隔着正文**，不许背靠背连着放两张——公众号里会变成上下两张图贴在一起
- 全文一共 ${IMG_MIN}-${IMG_MAX} 个，**多于 ${IMG_MAX} 个不合格，写完自己数一遍**
- 宁少勿多：配图是给读者喘口气的，不是给文章填空的。同一段里反复出现同一个东西（比如连放三张粥），只留一张
- 别都挤在前面，后半段也要有

画面描述要具体到能直接搜图，比如「${IMG_SLOT}黑巧克力掰开的特写】」「${IMG_SLOT}一碗杂粮粥放在餐桌上】」。
读者是照着你的描述去配图的，写得含糊等于没写。
`;

// ============================================================
// 阶段衔接指令
// ============================================================
const HANDOFF = `
⚠️ 以下是待处理的完整文章。请直接输出处理后的版本，不要加任何说明。
⚠️ 文章里所有【方括号标记】（【配图：...】和【固定小标题】）原样保留，不要删、不要改、不要新增。`;

// ============================================================
// Schema
// ============================================================
const TITLES_SCHEMA = {
  type: 'object',
  properties: {
    titles: {
      type: 'array',
      items: {
        type: 'object',
        properties: {
          type: { type: 'string', enum: ['反转型', '数字型', '痛点型', '悬念型', '对比型', '场景型'] },
          title: { type: 'string' },
          score: { type: 'number' },
        },
        required: ['type', 'title', 'score'],
      },
      minItems: 20, maxItems: 20,
    },
  },
  required: ['titles'],
};

const SELECTION_SCHEMA = {
  type: 'object',
  properties: {
    selected: {
      type: 'array',
      items: {
        type: 'object',
        properties: {
          rank: { type: 'number' },
          type: { type: 'string' },
          title: { type: 'string' },
          reason: { type: 'string' },
        },
        required: ['rank', 'type', 'title', 'reason'],
      },
      minItems: 1, maxItems: 1,
    },
  },
  required: ['selected'],
};

// ============================================================
// 固定文案拼接
// ============================================================

// 标题重排区：标题原文 + 断行版（逗号留在行尾，成果后缀括号单独成块）
const titleBlock = (title) => {
  const t = title.trim();
  const m = t.match(/^(.*?)(（[^）]*）)\s*$/);      // 拆出结尾的成果后缀
  const main = (m ? m[1] : t).trim();
  const tag = m ? m[2].trim() : '';
  const segs = main.split(/(?<=，)/).map(s => s.trim()).filter(Boolean); // 逗号后断行
  const parts = tag ? [...segs, tag] : segs;
  return parts.length > 1 ? `${t}\n\n${parts.join('\n\n')}` : t;
};

// 真心话小标题：优先认标记；agent 没写标记时，兜底找那条含"真心话"的短行替换掉
const fixSincereHeading = (text) => {
  if (text.includes('【固定小标题】')) return text.replace(/【固定小标题】/g, SINCERE_HEADING);
  const lines = text.split('\n');
  for (let i = lines.length - 1; i >= 0; i--) {
    const l = lines[i].trim();
    if (l && l.length <= 20 && l.includes('真心话')) {   // 短行才可能是小标题，长段落跳过
      lines[i] = SINCERE_HEADING;
      return lines.join('\n');
    }
  }
  return `${SINCERE_HEADING}\n\n${text}`;                // 都没有就补一个在最前面
};

// 结构名兜底：「成果播报／共鸣痛点／机制解释／主清单／小习惯」只是 prompt 里给 agent 看的
// 位置说明，不是给读者看的字。agent 偶尔会把它原样写成一行小标题（2026-09-20 香蕉那篇漏了 6 处），
// 这里强行抹掉该行。抹掉后正文自己接得下去，比留着内部黑话强。
// ⚠️ 必须在 fixSincereHeading 之后调用：那里面有「找含真心话的短行」的兜底，
// 提前删掉「真心话」那行会让它误判。
const STRUCT_LABELS = ['成果播报', '共鸣痛点', '机制解释', '主清单', '小习惯', '真心话'];
const stripStructLabels = (text) => text
  .split('\n')
  .filter(line => !STRUCT_LABELS.includes(line.trim()))
  .join('\n')
  .replace(/\n{3,}/g, '\n\n');                 // 删行后会留下空行，收一下

// 把引导块、正文、免责声明、结尾块拼成完整文章
const assemble = (title, body, topicLine) => {
  const opening = OPENING_BLOCK.replace('[主题一句话]', topicLine);
  // 兜底：公众号后台是纯文本粘贴，星号会原样露出来，不管 agent 怎么写都不能流出去
  let clean = body.trim().replace(/\*\*/g, '');
  // 真心话小标题放在最后一道处理：前半程用【固定小标题】标记让 HANDOFF 保护它，
  // 标记被 agent 吃掉时再退回到文本兜底（前面 5 个阶段都可能改写它）
  clean = clean.includes('【固定小标题】')
    ? clean.replace(/【固定小标题】/g, SINCERE_HEADING)
    : fixSincereHeading(clean);
  clean = stripStructLabels(clean);          // 结构名兜底，见上面注释（必须在真心话处理之后）
  return [
    titleBlock(title),
    opening,
    clean,
    DISCLAIMER,
    CLOSING_BLOCK,
  ].join('\n\n');
};

// 固定文案块的实际字数 —— 正文 agent 不写这几块，但它们算进成稿总字数，
// 所以 agent 的写作目标要先把这部分扣掉，否则成稿必超 2500
const FIXED_OVERHEAD = [
  OPENING_BLOCK.replace('[主题一句话]', ''),
  DISCLAIMER,
  CLOSING_BLOCK,
].join('').replace(/\s/g, '').length + 40;   // +40 给标题重排区留余量
const BODY_MIN = 1500 - FIXED_OVERHEAD;
const BODY_MAX = 2500 - FIXED_OVERHEAD;

// ============================================================
// 主流程
// ============================================================
const topic = args?.topic || '减脂';

// -------- Phase 1: 标题 --------
phase('🎯 标题生成');
log(`正在为「${topic}」方向生成 20 个爆款标题...`);

const titlesResult = await agent(
  `你是微信公众号减脂领域爆款标题写手。请为主题方向为「${topic}」的减脂类公众号生成 **20 个**标题。

## 标题类型分布（共20个）
- **反转型**（3个）：先立错误认知，再推翻。是当前最能打的句式
- **数字型**（4个）：带具体数字，数字优先用 3 或 4（小数字看着读得完）
- **痛点型**（4个）：直击减脂核心焦虑（反弹、平台期、腰腹、没时间）
- **悬念型**（3个）：制造信息缺口
- **对比型**（3个）：反差冲击
- **场景型**（3个）：具体生活场景

## 固定成果后缀（重要）
作者的真实数据是 从 ${START_WEIGHT} 斤到 ${NOW_WEIGHT} 斤、瘦了 ${LOST_WEIGHT} 斤。**大部分标题（约 15 个）要在结尾带上成果后缀**，从这几种里换着用，不要 20 个全带、也不要全不带：
- ${WEIGHT_TAG}
- （已掉${LOST_WEIGHT}斤）
- （${START_WEIGHT}-${NOW_WEIGHT}）
- （瘦了${LOST_WEIGHT}斤）

## 可复用句式模板（20个标题要覆盖到这些模板）
1. **反转型**：你以为很增肥，其实巨减脂的3种食物 → 反差词用"其实""反而""居然"
2. **前缀强调型**：重要的事说三遍！／再说一遍！／一次讲清楚
3. **结论前置型**：掉秤的解法：吃蛋白质 ／ 瘦了${LOST_WEIGHT}斤告诉你：……
4. **禁止清单型**：早餐少吃4种"传统碳水" ／ 这3种水果我基本不碰
5. **时间锚定型**：把季节、节假日、月份挂进标题（如"秋天""国庆前"）
6. **日常食物型**：钩子用家里就有的东西（香蕉、鸡蛋、豆腐皮、柚子、燕麦）

## 法则
1. 12-30字（后缀括号不计入）
2. 钩子必须是**具体食物或具体行为**，不要抽象概念
3. 暗示可执行
4. 禁止贩卖焦虑、禁止虚假数字

## 合规红线（不许破）
- 禁止"唯一""最快""必须""彻底""根治""巨"这类绝对化用语，反转型也一样
- 反差用"其实""反而""居然"表达，不用"最""唯一"

## 输出
按score从高到低排列，每个标题打分1-100。`,
  { label: '生成20个标题', schema: TITLES_SCHEMA }
);

if (!titlesResult) { log('❌ 标题生成失败'); return { error: '标题生成未返回结果' }; }

log(`✅ 生成 ${titlesResult.titles.length} 个标题`);
titlesResult.titles.slice(0, 5).forEach(t => log(`   ${t.score}分 | ${t.type} | ${t.title}`));

// -------- Phase 2: 精选 --------
phase('⭐ 标题甄选');

const titlesList = titlesResult.titles
  .map((t, i) => `${i + 1}. [${t.type}] ${t.title} (评分:${t.score})`)
  .join('\n');

const selectionResult = await agent(
  `从以下20个标题中精选最佳的 **1个**（今天只发这一篇，务必选最能打的）。

## 标准
1. 点击吸引力（20个里最强的那一个）
2. 内容承载量（能扎实展开成1500-2500字，有具体可执行的做法）
3. 传播潜力（适合收藏、转发）

## 候选标题
${titlesList}

## 输出
为选中的标题写1-2句理由。`,
  { label: '精选1个标题', schema: SELECTION_SCHEMA }
);

if (!selectionResult) { log('❌ 标题甄选失败'); return { error: '标题甄选未返回结果', titlesResult }; }

log(`✅ 精选 ${selectionResult.selected.length} 个标题（今日只发这1篇）`);
selectionResult.selected.forEach(s => log(`   🏆 #${s.rank} ${s.title}`));

// 甄选 agent 偶尔会把候选列表里的「[对比型]」类型标签连标题一起抄回来（2026-09-20 那篇），
// 它会跟着进标题重排区和正文 prompt，必须在往下走之前去掉。只删已知的类型名，避免误伤标题本身。
const TYPE_TAGS = ['反转型', '数字型', '痛点型', '悬念型', '对比型', '场景型'];
selectionResult.selected.forEach(s => {
  const m = s.title.match(/^\s*\[([^\]]{1,8})\]\s*/);
  if (m && TYPE_TAGS.includes(m[1])) s.title = s.title.slice(m[0].length);
});

// -------- Phase 3: 文章流水线 --------
phase('📝 文章流水线');
log('启动流水线，闺蜜聊天风，1500-2500字...');

const articles = await pipeline(
  selectionResult.selected,

  // --- Stage 1: 正文生成 ---
  async (item) => {
    log(`📄 正文: ${item.title.slice(0, 20)}...`);
    const raw = await agent(
      `你是「${ACCOUNT}」的作者${AUTHOR}，一个减脂成功的普通女生。请基于标题写一篇公众号长文，${BODY_MIN}-${BODY_MAX}字。

${PERSONA}

${ARTICLE_SPEC}

## 标题
《${item.title}》

## 字数要求
**你实际写 ${BODY_MIN}-${BODY_MAX} 字**（不含配图占位符）。

为什么是这个数：成稿总字数要求 1500-2500 字，而系统还会自动拼上标题行、开头引导块、免责声明、结尾转化块，这几块加起来约 ${FIXED_OVERHEAD} 字。你写超了，成稿就超 2500 了。

这是长文，每一项都要写透，不要为了省字数把清单项压缩成一句话；但也别为了凑字数反复绕。

## 关键提醒
- 你是普通女生在分享经验，不是专家在讲课
- 用亲身经历说话，不要抽象地讲道理
- 每一段都像是在跟姐妹们唠嗑
- **禁止任何金句和华丽比喻**，用最普通的大白话
- 语气词自然地用：呀、哦、啦、嘛

## 输出格式（严格遵守）

第一行先输出一行主题短语，格式：
【主题一句话】秋天这几样被冤枉的食物

这句会填进文章开头的引导块，读者第一眼就看到。要求：
- 8-18字，是个短语不是句子，不要标点结尾
- **必须是这篇文章"讲什么"**。下面两个只是格式示例，**按本文实际内容另写，不要照抄**：
  - 示例格式：〈季节/场景〉+〈这几样/几种〉+〈什么〉
- ❌ 不要写机制名词（"管理体重降低皮质醇"这类）——机制是正文里解释的东西，不是主题

第二行空一行，然后才是正文（从"成果播报"开始，到"真心话"结束；真心话的小标题那一行只写「【固定小标题】」）。
不要加"以下是文章"之类的话。`,
      { label: `正文:${item.title.slice(0, 15)}` }
    );
    if (!raw) { log(`   ❌ 正文失败`); return null; }
    // 抽出主题短语，并从正文里删掉这一行，后续阶段不再看到它
    const m = raw.match(/【主题一句话】\s*(.+)/);
    const topicLine = m ? m[1].trim() : item.title.replace(/（[^）]*）/g, '').trim();
    // 真心话小标题先修正，再换回【固定小标题】标记 —— 后半程 4 个 agent 都会改写它，
    // 只有标记形态才能被 HANDOFF 保住，最终由 assemble() 换回固定文案
    const body = fixSincereHeading(
      raw.replace(/【主题一句话】.*(\r?\n)?/, '')
    ).trim().replace(SINCERE_HEADING, '【固定小标题】');
    log(`   ✅ 正文完成（${body.length}字）｜主题短语：${topicLine}`);
    return { ...item, body, topicLine };
  },

  // --- Stage 2: 人设润色 ---
  async (data) => {
    const item = data;
    log(`👤 人设: ${item.title.slice(0, 20)}...`);
    const polished = await agent(
      `${HANDOFF}

你是内容编辑。请确保文章读起来像「${ACCOUNT}」的${AUTHOR}在跟闺蜜分享经验。

${PERSONA}

## 润色（只改语气，不增删内容）
1. 把任何"教练/专家/教程"口吻改成"姐妹分享"口吻
2. 把"你应该/你必须"改成"姐妹们可以试试/我的经验是"
3. 删除任何不小心冒出来的金句、比喻、华丽句子，改成大白话
4. 确保第三人称自称"${AUTHOR}"自然分布（平均每1-2段一次，不要每句都叫）
5. 把任何书面语改成口语（如"进行运动"→"去运动"）
6. 数字检查：${START_WEIGHT}斤、${NOW_WEIGHT}斤、${LOST_WEIGHT}斤这三个数字必须前后一致，出现矛盾就以 ${START_WEIGHT}→${NOW_WEIGHT}、${LOST_WEIGHT}斤为准改过来
7. 清单的 5 拍结构（小标题/副标题/踩坑/原理/替代方案）不许改动或合并

## 待处理：
${item.body}`,
      { label: `人设:${item.title.slice(0, 15)}` }
    );
    if (!polished) { log(`   ❌ 人设失败，沿用正文`); return item; }
    log(`   ✅ 人设完成`);
    return { ...item, body: polished };
  },

  // --- Stage 3: 情绪增强 ---
  async (data) => {
    const item = data;
    log(`💕 情绪: ${item.title.slice(0, 20)}...`);
    const enhanced = await agent(
      `${HANDOFF}

你是情感编辑。请增强文章的"真实感"，不是煽情。

${PERSONA}

## 增强（每种1处即可，不要多）
1. 1处自嘲或真实感受："给我气的呀""当时真的想放弃了""说实话挺委屈的"
2. 1处共鸣提问："姐妹们，你们是不是也...？"
3. 1处自然的鼓励（基于内容，不空洞）："这个方法对我管用，希望对你们也管用"这种程度就够了

## 原则
- 真实 > 煽情
- 普通 > 华丽
- 姐妹唠嗑 > 情感文案
- 不要加金句！
- 不要去动清单的 5 拍结构

## 待处理：
${item.body}`,
      { label: `情绪:${item.title.slice(0, 15)}` }
    );
    if (!enhanced) { log(`   ❌ 情绪失败，沿用上一步`); return item; }
    log(`   ✅ 情绪完成`);
    return { ...item, body: enhanced };
  },

  // --- Stage 4: 排版优化 ---
  async (data) => {
    const item = data;
    log(`📐 排版: ${item.title.slice(0, 20)}...`);
    const formatted = await agent(
      `${HANDOFF}

你是公众号排版。在保持内容完全不变的前提下优化手机端阅读。

## 规则
1. 每段不超过3句话，长段拆分。一句话一段完全没问题
2. 段落间空1行
3. 小标题**用纯文本**单独成行，不加emoji、不加 # 或 ## 或 **（粘到公众号后台这些符号会原样露出来）
4. 【固定小标题】这个标记原样保留，不要替换成别的字，也不要给它加 # 或 **
5. **全文不许出现 \`**\` 加粗符号**，正文里已有的 \`**xxx**\` 要全部去掉星号。公众号后台是纯文本粘贴，星号会原样露出来。想强调就把话说重一点
6. 清单项的副标题（如"小小一颗，热量高得离谱"）单独成行，放在小标题下面
7. 配图占位符【配图：...】单独成行，前后各空1行

## 待处理：
${item.body}`,
      { label: `排版:${item.title.slice(0, 15)}` }
    );
    if (!formatted) { log(`   ❌ 排版失败，沿用上一步`); return item; }
    log(`   ✅ 排版完成`);
    return { ...item, body: formatted };
  },

  // --- Stage 5: AI去味 ---
  async (data) => {
    const item = data;
    log(`🧹 去味: ${item.title.slice(0, 20)}...`);
    const deflavored = await agent(
      `${HANDOFF}

你是口语化编辑。让文章读起来像真人发的微信语音，不像AI写的。

${PERSONA}

## 必做
1. 把所有AI过渡词（首先/其次/最后/此外/因此/综上所述）替换成口语或直接删掉
2. 30字以上的长句拆成短句
3. 书面后缀改口语："有效性"→"管不管用"
4. 被动句改主动句
5. 连续3个"的"的句子拆开
6. 自然地加语气词（呀、哦、啦、嘛），但不要硬加每句都有
7. 把"进行""加以""予以"删掉，换直接动词
8. **术语错别字专项检查**：卵磷脂（不是卯磷脂）、精制碳水（不是精致碳水）、升糖指数、饱腹感、膳食纤维——写错一个都会显得很业余
9. **数字自查**：${START_WEIGHT}→${NOW_WEIGHT}、${LOST_WEIGHT}斤，全文必须一致；清单项写了几项就说几项，不许出现"这3种"却列了4种的情况

## 检验
改完默读一遍：这像不像你按住微信语音键给闺蜜发的一段话？不像就继续改。

## 待处理：
${item.body}`,
      { label: `去味:${item.title.slice(0, 15)}` }
    );
    if (!deflavored) { log(`   ❌ 去味失败，沿用上一步`); return item; }
    log(`   ✅ 去味完成`);
    return { ...item, body: deflavored };
  },
);

// -------- 拼接固定文案 --------
const finalArticles = articles
  .filter(Boolean)
  .map(a => {
    const full = assemble(a.title, a.body, a.topicLine);
    return {
      rank: a.rank,
      type: a.type,
      title: a.title,
      reason: a.reason,
      openingTopic: a.topicLine,
      body: full,              // 完整成稿（含引导块/免责声明/结尾块）
      content: a.body.trim(),  // 纯正文（不含固定文案）
      wordCount: full.replace(/【配图：[^】]*】/g, '').replace(/\s/g, '').length,
      imageSlots: (full.match(/【配图：/g) || []).length,
    };
  });

// -------- 汇总 --------
log('');
log('═══════════════════════════════════');
log(`🎉 完成！共 ${finalArticles.length} 篇文章`);
log('═══════════════════════════════════');
finalArticles.forEach((a, i) => {
  log(`📄 文章${i + 1}: 《${a.title}》`);
  log(`   正文 ${a.wordCount} 字 | 配图位 ${a.imageSlots} 个`);
});

return {
  topic,
  account: ACCOUNT,
  author: AUTHOR,
  weightTag: WEIGHT_TAG,
  allTitles: titlesResult.titles,
  selected: selectionResult.selected,
  articles: finalArticles,
};
